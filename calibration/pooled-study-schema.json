{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-iq-lab.local/calibration/pooled-study-export-v1.json",
  "title": "Cognitive IQ Lab manual calibration export accepted by the pooled-study tool",
  "type": "object",
  "required": ["schemaVersion", "sourceKey", "privacy", "productStatus", "sessions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "bankVersion": { "type": ["string", "null"] },
    "bankRevision": { "type": ["string", "number", "null"] },
    "sourceKey": { "type": "string", "minLength": 8, "not": { "const": "local-unavailable" } },
    "privacy": {
      "type": "object",
      "required": ["automaticUpload", "containsName", "containsAccount", "containsDateOfBirth", "containsIp", "containsLocation"],
      "properties": {
        "automaticUpload": { "const": false },
        "containsName": { "const": false },
        "containsAccount": { "const": false },
        "containsDateOfBirth": { "const": false },
        "containsIp": { "const": false },
        "containsLocation": { "const": false }
      }
    },
    "productStatus": {
      "type": "object",
      "required": ["iqEstimateAvailable", "populationNormed"],
      "properties": {
        "cpiAvailable": { "type": "boolean" },
        "iqEstimateAvailable": { "const": false },
        "populationNormed": { "const": false }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sessionId", "sourceKey", "ageYears", "ageBand", "rows"],
        "properties": {
          "sessionId": { "type": "string", "minLength": 8 },
          "sourceKey": { "type": "string", "minLength": 8, "not": { "const": "local-unavailable" } },
          "createdAt": { "type": ["string", "null"] },
          "ageYears": { "type": "integer", "minimum": 18, "maximum": 65 },
          "ageBand": { "enum": ["18–24", "25–34", "35–44", "45–54", "55–65"] },
          "cpi": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "iqEstimate": { "type": "null" },
          "iqStatus": { "type": ["string", "null"] },
          "anchorStudy": {
            "type": ["object", "null"],
            "properties": {
              "optIn": { "type": "boolean" },
              "completed": { "type": "boolean" },
              "status": { "type": "string" }
            }
          },
          "rows": {
            "type": "array",
            "minItems": 42,
            "items": { "$ref": "schema.json" }
          }
        }
      }
    }
  },
  "$comment": "Pooling is manual/offline. Only sessions with anchorStudy.optIn=true are included in the pooled cohort. The pooling script additionally requires exactly 42 unique formal items, validates matrix slots, verifies completed six-domain anchor blocks, and recursively rejects identifying keys."
}
