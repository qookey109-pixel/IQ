{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-iq-lab.local/calibration/schema-v1.json",
  "title": "Cognitive IQ Lab pooled calibration response row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceKey",
    "sessionId",
    "ageYears",
    "ageBand",
    "bankVersion",
    "bankRevision",
    "scoringVersion",
    "itemId",
    "domain",
    "correct",
    "skipped",
    "timeout",
    "seconds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceKey": { "type": "string", "minLength": 8 },
    "sessionId": { "type": "string", "minLength": 8 },
    "ageYears": { "type": "integer", "minimum": 18, "maximum": 65 },
    "ageBand": { "enum": ["18–24", "25–34", "35–44", "45–54", "55–65"] },
    "bankVersion": { "type": "string" },
    "bankRevision": { "type": ["string", "number"] },
    "scoringVersion": { "type": ["string", "null"] },
    "formId": { "type": ["string", "null"] },
    "itemId": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "family": { "type": ["string", "null"] },
    "semanticKey": { "type": ["string", "null"] },
    "difficulty": { "enum": ["easy", "medium", "hard", null] },
    "selectedOption": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "correctOption": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "correct": { "enum": [0, 1] },
    "skipped": { "enum": [0, 1] },
    "timeout": { "enum": [0, 1] },
    "seconds": { "type": "number", "minimum": 0 },
    "cpi": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "iqEstimate": { "type": "null" }
  }
}
