        "mayBeInferred": false,
        "refusalAllowed": true
      },
      "macroRegion": {
        "type": "enum",
        "allowedValues": ["north", "central", "south", "east", "offshore", "not-stated"],
        "benchmarkableValues": ["north", "central", "south", "east", "offshore"],
        "purpose": "Coarse geographic calibration margin without storing precise location or raw county/city.",
        "mayBeInferredFromIp": false,
        "refusalAllowed": true
      }
    }
  },
  "normingWeightEligibility": {
